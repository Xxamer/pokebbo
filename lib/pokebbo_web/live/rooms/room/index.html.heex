<div class="h-screen flex flex-col">
  <header class="p-4 bg-base-200">
    <h1 class="text-xl font-bold">
     <%= @room_id %> -
     <%= @room.name %>
    </h1>
  </header>

  <main class="flex-1">
  <!--  PIXIJS -->
  <div class="flex">
       <form phx-submit="send_message" class="flex gap-4 mt-6">
        <input type="text"  name="message" placeholder="Message" class="input input-bordered flex-1" />

        <button class="btn btn-primary">
          Send message
        </button>
      </form>
  </div>
  </main>
</div>